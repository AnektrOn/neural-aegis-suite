# Copy to `.env` for local Vite/Capacitor. Never commit real values.
# Frontend keys are "publishable" (anon) — still keep them out of a public repo
# and rely on Supabase RLS. Server secrets belong in Supabase Edge secrets only.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Optional aliases used by some scripts
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key

# Optional UI / payments (publishable only — never sk_live / service_role here)
# VITE_PAYMENTS_CLIENT_TOKEN=
# VITE_APP_URL=http://localhost:8080
# VITE_ADMIN_NOTIFICATION_EMAIL=admin@example.com

# See also: .env.production.example, .env.staging.example
