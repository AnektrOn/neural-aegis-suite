# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# ── Secrets & env (never commit real values) ─────────────────────────
.env
.env.*
!.env.example
!.env.*.example
!.env.production.example
!.env.staging.example

# Local secret dumps / AppSumo codes / scratch
.tmp-appsumo/
.tmp*/
supabase/.temp/
*.pem
*.p12
*.p8
*service-account*.json
*firebase-adminsdk*.json
credentials.json
secrets/

# Android signing (also covered under android/.gitignore)
android/keystore.properties
android/keystore/*.keystore
android/keystore/*.jks
android/app/google-services.json
android/app/google-services.json.backup

# Built Android packages (keep locally; use CI artifacts for sharing)
*.apk
*.aab

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.cursor/

# TypeScript incremental
*.tsbuildinfo

.tmp-ui-shots/

# Local exports / screenshots (keep on disk, never push)
exports/

# Heavy binary archives
*.zip

# Prism landing 3D assets — stay on your Mac, not on GitHub
# (textures, models, HDRIs). Code + ASSETS.md stay tracked.
src/pages/dev/prism-landing/assets/textures/
src/pages/dev/prism-landing/assets/gltf/
src/pages/dev/prism-landing/assets/hdri/
src/pages/dev/prism-landing-r3f/assets/textures/
src/pages/dev/prism-landing-r3f/assets/hdri/

# Other large 3D models
*.glb
*.hdr
