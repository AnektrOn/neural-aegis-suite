# Staging environment (Vite mode: staging)
# Copy to .env.staging and fill values. Never commit real secrets.

VITE_APP_ENV=staging
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SENTRY_DSN=

# Stripe test mode is configured on Edge Function secrets, not in the browser:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
