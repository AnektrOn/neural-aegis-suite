# Copy to .env.production for production Vite/Capacitor builds (do not commit real values).
# Same variables as local dev; Vite embeds these at build time.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key
VITE_ADMIN_NOTIFICATION_EMAIL=admin@your-company.com

# Public app URL (used in UI; must match Supabase edge secret APP_BASE_URL for email links)
# VITE_APP_URL=https://app.your-domain.com

# Visitor funnel (optional)
# VITE_VISITOR_AUDIT_BOOKING_URL=https://calendly.com/your-team/audit
# VITE_VISITOR_PAYMENT_CTA_URL=

# URL publique (liens dans les e-mails newsletter)
VITE_APP_URL=https://aegis.humancatalystbeacon.com
# APP_BASE_URL=https://aegis.humancatalystbeacon.com  ← secret Supabase Edge (même URL)
#
# Newsletter — Hostinger SMTP (secrets UNIQUEMENT dans Supabase Dashboard, jamais commités) :
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=contact@protocolenomos.com
# SMTP_PASSWORD=<mot de passe boîte mail Hostinger>
# NEWSLETTER_FROM_EMAIL=Protocol Nomos <contact@protocolenomos.com>
# IMAP (lecture mail, non utilisé par l'app) : imap.hostinger.com
#
# Optionnel — alertes admin (send-email-notification) si vous gardez Resend :
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=Protocol Nomos <contact@protocolenomos.com>

# Optional (local .env / .env.local only): keep the boot loader visible at least N ms after app mount (0 = off).
# VITE_MIN_AUTH_LOADING_MS=2500
#
# Capacitor: forced AEGIS boot screen (defaults apply if unset).
# VITE_NATIVE_BOOT_MIN_MS=1650
# VITE_NATIVE_RESUME_BOOT_MS=1400
#
# Supabase Edge Function send-push — legacy FCM server key for Android/iOS (Capacitor), not bundled in the app:
# FCM_SERVER_KEY=AAAA... (Firebase Console → Project settings → Cloud Messaging, or legacy Server key)

# Supabase Edge Function import-drive-links (set as Supabase secrets, never expose to frontend):
# GOOGLE_CLIENT_EMAIL=service-account@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SERVICE_ACCOUNT_SCOPES=https://www.googleapis.com/auth/drive.readonly

# Supabase Dashboard → Authentication → URL configuration:
# Add redirect / site URL allowances used by Capacitor WebView, e.g.:
#   capacitor://localhost
#   http://localhost
#   https://localhost
# Add OAuth redirect URLs if you use social login.
